# Template only; NEVER commit actual keys or DATABASE_URL values.
# Set these as Railway service variables after staging budget/deploy approval.
SUPABASE_URL=https://llbkxnazkliskzcureec.supabase.co
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Runtime cwd is railway-runtime; build copies this PUBLIC CA from repo root.
# The Node pg client uses this CA with rejectUnauthorized=true and validates host.
PG_SSL_ROOT_CERT_PATH=backend/supabase/prod-ca-2021.crt
# DATABASE_URL must target ONLY restricted-login Session Pooler host:5432/postgres.
# No sslmode or other query parameters in URL; never use postgres owner credentials.
NODE_ENV=production
# Railway sets PORT at runtime; no manual value needed.
# Google provider needs OAuth Client ID + Secret configured inside Supabase,
# with redirect URLs and Railway app URL authorized, not in this file.
