{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python3 tools/prepare_railway_secure.py && cd railway-runtime && npm install --omit=dev --no-audit --no-fund"
  },
  "deploy": {
    "startCommand": "cd railway-runtime && npm start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
